# Environment Variables for Frontend
PORT=4000
# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Backend API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:4011
NEXT_PUBLIC_ENCYCLOPEDIA_API_KEY=your_api_key_here

# Get your API key by running: npm run seed-encyclopedia
# The script will output an API key that you should paste above

