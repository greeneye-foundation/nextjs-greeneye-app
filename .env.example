# ==============================================
# GreenEye Frontend Environment Configuration
# ==============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Backend API ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ---- Encyclopedia ----
# Get your API key by running: cd greeneye-be && npm run seed-encyclopedia
NEXT_PUBLIC_ENCYCLOPEDIA_API_KEY=your-encyclopedia-api-key

# ---- Payment: PayU ----
NEXT_PUBLIC_PAYU_URL=https://test.payu.in/_payment

# ---- reCAPTCHA ----
NEXT_PUBLIC_CAPTCHA_KEY=your-recaptcha-site-key

# ---- AQI Widget ----
# Get a free token from https://aqicn.org/data-platform/token/
NEXT_PUBLIC_WAQI_TOKEN=your-waqi-token

# ---- Cloudinary (image hosting) ----
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---- Instagram Feed ----
IG_USER_ID=your-instagram-user-id
IG_ACCESS_TOKEN=your-instagram-access-token
IG_MEDIA_LIMIT=12
